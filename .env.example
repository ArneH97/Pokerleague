# Supabase — te vinden onder Settings > API Keys
#
# Gebruik de nieuwe sleutels (tab "API Keys"), niet de legacy anon/service_role
# JWT's uit het tabblad "Legacy API Keys". Die laatste worden eind 2026
# uitgefaseerd en dit project begint pas.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# sb_publishable_... — mag in de browser staan. RLS beschermt de data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# sb_secret_... — omzeilt RLS. Nooit met NEXT_PUBLIC_ ervoor, nooit in git.
SUPABASE_SECRET_KEY=

# Alleen lokaal, voor migraties en tests vanaf de commandline.
# Hoort NIET in Vercel: de applicatie praat via de Supabase-client, niet
# rechtstreeks met Postgres.
DATABASE_URL=postgresql://postgres:[wachtwoord]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Het domein van het spelersplatform. Alles wat hier niet op binnenkomt en
# wel bij een club hoort (clubs.custom_domain) wordt naar die clubomgeving
# doorgeschreven.
NEXT_PUBLIC_LEAGUE_DOMAIN=pokerleague.be

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Resend. De sleutel staat alleen op de server: geen NEXT_PUBLIC_ ervoor, en
# nooit in git. Te maken op resend.com onder API Keys.
RESEND_API_KEY=

# Het adres waar uitnodigingen vandaan komen. Moet onder het domein vallen dat
# in Resend geverifieerd is — bij ons de send.-laag, want dat is waar Resend
# zijn eigen MX en SPF neerzet zonder de gewone mail van het domein te raken.
# De naam ervoor wordt per mail gezet: de speler ziet zijn club als afzender.
MAIL_FROM=uitnodiging@send.pokerleague.be

# Waar de links in die mails naartoe wijzen. Zonder dit valt de verzender terug
# op het adres waarop het verzoek binnenkwam, en dat is bij een cronjob het
# ruwe Vercel-adres van de deployment.
NEXT_PUBLIC_SITE_URL=https://www.pokerleague.be

# Gedeeld geheim tussen Vercel Cron en de verzendroute. Vercel zet dit zelf als
# Authorization-header zodra deze variabele bestaat. Zonder dit kan alleen een
# aangemeld bestuurslid de wachtrij leeghalen, en dan enkel voor eigen clubs.
# Genereer iets willekeurigs: openssl rand -hex 32
CRON_SECRET=
