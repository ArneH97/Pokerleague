# Supabase — te vinden onder Settings > API Keys
#
# LET OP: dit bestand staat WEL in git. Vul hier nooit echte waarden in.
# Kopieer het naar .env.local (dat is genegeerd) en zet je sleutels daar.
#
# Gebruik de nieuwe sleutels (tab "API Keys"), niet de legacy anon/service_role
# JWT's uit het tabblad "Legacy API Keys". Die laatste worden eind 2026
# uitgefaseerd en dit project begint pas.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# sb_publishable_... — mag in de browser staan. RLS beschermt de data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# sb_secret_... — omzeilt RLS volledig. Nooit met NEXT_PUBLIC_ ervoor,
# nooit in dit bestand, nooit in git.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Alleen lokaal, voor migraties en tests vanaf de commandline.
# Hoort NIET in Vercel: de applicatie praat via de Supabase-client, niet
# rechtstreeks met Postgres.
DATABASE_URL=postgresql://postgres:[wachtwoord]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
